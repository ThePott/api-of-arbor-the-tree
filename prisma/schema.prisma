generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model hagwon {
    id         BigInt      @id @default(autoincrement())
    name       String?     @unique @db.VarChar(255)
    principal  principal?
    student    student[]
    helpers    helper[]
    classrooms classroom[]
}

model app_user {
    id           BigInt     @id @default(autoincrement())
    name         String     @db.VarChar(255)
    role         role?
    phone_number String?    @unique @db.VarChar(16)
    kakao_id     BigInt?    @unique
    email        String?    @unique
    password     String?    @db.VarChar(255)
    principal    principal?
    helper       helper?
    student      student?
    parent       parent?
    resume       resume?
    syllabi      syllabus[]
}

model principal {
    id        BigInt    @id @default(autoincrement())
    hagwon_id BigInt    @unique
    user_id   BigInt    @unique
    hagwon    hagwon    @relation(fields: [hagwon_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    users     app_user? @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model student {
    id                       BigInt                      @id @default(autoincrement())
    user_id                  BigInt                      @unique
    school_id                BigInt
    hagwon_id                BigInt
    grade                    Int?
    parent_student           parent_student[]
    users                    app_user                    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    hagwon                   hagwon                      @relation(fields: [hagwon_id], references: [id])
    school                   school                      @relation(fields: [school_id], references: [id])
    classroomStudents        classroom_student[]
    studentSyllabuses        student_syllabus[]
    assignedSessionStudents  assigned_session_student[]
    completedSessionStudents completed_session_student[]
    reviewAssignments        review_assignment[]

    @@index([user_id], map: "idx_student_user_id")
}

model school {
    id       BigInt    @id @default(autoincrement())
    name     String    @db.VarChar(255)
    students student[]
}

model parent {
    id             BigInt           @id @default(autoincrement())
    user_id        BigInt           @unique
    users          app_user         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    parent_student parent_student[]
}

model parent_student {
    id         BigInt  @id @default(autoincrement())
    student_id BigInt
    parent_id  BigInt
    parent     parent  @relation(fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    student    student @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model helper {
    id        BigInt   @id @default(autoincrement())
    user_id   BigInt   @unique
    hagwon_id BigInt
    hagwon    hagwon   @relation(fields: [hagwon_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    users     app_user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model resume {
    id          BigInt   @id @default(autoincrement())
    user_id     BigInt   @unique
    role        role
    school_name String?  @db.VarChar(255)
    hagwon_name String   @db.VarChar(20)
    applied_at  DateTime @default(now())
    users       app_user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum role {
    STUDENT
    PARENT
    PRINCIPAL
    HELPER
    MAINTAINER
}

model book {
    id             BigInt     @id @default(autoincrement())
    title          String     @unique @db.VarChar(255)
    published_year Int
    topics         topic[]
    syllabi        syllabus[]
}

model topic {
    id      BigInt @id @default(autoincrement())
    title   String @db.VarChar(255)
    order   Int
    book_id BigInt
    book    book?  @relation(fields: [book_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    steps   step[]

    @@unique([title, book_id])
    @@unique([order, book_id])
}

model step {
    id        BigInt     @id @default(autoincrement())
    title     String     @db.VarChar(255)
    order     Int
    topic_id  BigInt
    topic     topic?     @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    questions question[]

    @@unique([title, topic_id])
    @@unique([order, topic_id])
}

model question {
    id               BigInt             @id @default(autoincrement())
    name             String             @db.VarChar(255)
    page             Int
    solution_page    Int
    order            Int
    step_id          BigInt
    sub_question_id  BigInt?
    step             step?              @relation(fields: [step_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    sub_question     question?          @relation("SubQuestion", fields: [sub_question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    super_question   question[]         @relation("SubQuestion")
    sessionQuestions session_question[]
    reviewChecks     review_check[]

    @@unique([name, step_id])
    @@unique([order, step_id])
}

model syllabus {
    id         BigInt   @id @default(autoincrement())
    user_id    BigInt
    book_id    BigInt
    created_at DateTime @default(now())

    app_user            app_user             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    book                book                 @relation(fields: [book_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    sessions            session[]
    classroomSyllabuses classroom_syllabus[]
    studentSyllabuses   student_syllabus[]
}

model session {
    id                         BigInt                        @id @default(autoincrement())
    order                      Int
    syllabus_id                BigInt
    syllabus                   syllabus                      @relation(fields: [syllabus_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    sessionQuestions           session_question[]
    assignedSessionClassrooms  assigned_session_classroom[]
    assignedSessionStudents    assigned_session_student[]
    completedSessionStudents   completed_session_student[]
    completedSessionClassrooms completed_session_classroom[]

    @@unique([order, syllabus_id])
}

model session_question {
    id          BigInt   @id @default(autoincrement())
    session_id  BigInt
    question_id BigInt
    session     session  @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    question    question @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

    @@unique([session_id, question_id])
}

model classroom {
    id                         BigInt                        @id @default(autoincrement())
    name                       String                        @db.VarChar(255)
    hagwon_id                  BigInt
    hagwon                     hagwon                        @relation(fields: [hagwon_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    classroomStudents          classroom_student[]
    classroomSyllabuses        classroom_syllabus[]
    assignedSessionClassrooms  assigned_session_classroom[]
    completedSessionClassrooms completed_session_classroom[]

    @@unique([name, hagwon_id])
}

model classroom_student {
    id           BigInt @id @default(autoincrement())
    classroom_id BigInt
    student_id   BigInt

    classroom classroom @relation(fields: [classroom_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    student   student   @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

    @@unique([classroom_id, student_id])
}

enum session_status {
    HOMEWORK
    TODAY
}

model classroom_syllabus {
    id           BigInt    @id @default(autoincrement())
    classroom_id BigInt
    syllabus_id  BigInt
    completed_at DateTime?

    classroom classroom @relation(fields: [classroom_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    syllabus  syllabus  @relation(fields: [syllabus_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

    @@unique([classroom_id, syllabus_id])
}

model student_syllabus {
    id           BigInt    @id @default(autoincrement())
    student_id   BigInt
    syllabus_id  BigInt
    completed_at DateTime?

    student  student  @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    syllabus syllabus @relation(fields: [syllabus_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

    @@unique([student_id, syllabus_id])
}

model assigned_session_classroom {
    id           BigInt         @id @default(autoincrement())
    session_id   BigInt
    classroom_id BigInt
    status       session_status
    assigned_at  DateTime       @updatedAt

    session   session   @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    classroom classroom @relation(fields: [classroom_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

    @@unique([session_id, classroom_id])
}

model assigned_session_student {
    id          BigInt         @id @default(autoincrement())
    session_id  BigInt
    student_id  BigInt
    status      session_status
    assigned_at DateTime       @updatedAt

    session      session        @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    student      student        @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    reviewChecks review_check[]

    @@unique([session_id, student_id])
}

// NOTE: 반 진도 완료 용으로만 사용 (반의 학생한테는 적용 안 됨)
model completed_session_classroom {
    id           BigInt   @id @default(autoincrement())
    session_id   BigInt
    classroom_id BigInt
    completed_at DateTime @default(now())

    session   session   @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    classroom classroom @relation(fields: [classroom_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

    @@unique([session_id, classroom_id])
}

// NOTE: 학생이 실제로 완료했는지를 기록하는 데에 사용. 개별, 반 진도의 학생 모두 이걸 사용
model completed_session_student {
    id           BigInt   @id @default(autoincrement())
    session_id   BigInt
    student_id   BigInt
    completed_at DateTime @default(now())

    session session @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    student student @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

    @@unique([session_id, student_id])
}

enum review_check_status {
    CORRECT
    WRONG
}

model review_check {
    id                          BigInt              @id @default(autoincrement())
    assigned_session_student_id BigInt
    question_id                 BigInt
    status                      review_check_status

    assigned_session_student  assigned_session_student     @relation(fields: [assigned_session_student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    question                  question                     @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    reviewAssignmentQuestions review_assignment_question[]
}

model review_assignment {
    id           BigInt    @id @default(autoincrement())
    student_id   BigInt
    assigned_at  DateTime  @default(now())
    completed_at DateTime? @updatedAt

    student                   student                      @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    reviewAssignmentQuestions review_assignment_question[]
}

model review_assignment_question {
    id                   BigInt               @id @default(autoincrement())
    review_assignment_id BigInt
    review_check_id      BigInt
    status               review_check_status?
    completed_at         DateTime             @updatedAt

    review_assignment review_assignment @relation(fields: [review_assignment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    review_check      review_check      @relation(fields: [review_check_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
