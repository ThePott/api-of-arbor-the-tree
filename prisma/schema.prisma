generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id           BigInt      @id
    name         String      @db.VarChar(255)
    role         String      @db.VarChar(255)
    phone_number String      @db.VarChar(16)
    principal    Principal[]
    helper       Helper[]
    student      Student[]
    parent       Parent[]

    @@map("users")
}

model Principal {
    id          BigInt   @id
    hagwon_id   BigInt
    user_id     BigInt?
    is_approved Boolean?
    helper      Helper[]
    hagwon      Hagwon   @relation(fields: [hagwon_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    users       User?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Hagwon {
    id        BigInt      @id
    name      String?     @db.VarChar(255)
    principal Principal[]
    student   Student[]
}

model School {
    id      BigInt    @id
    name    String    @db.VarChar(255)
    student Student[]
}

model Student {
    id             BigInt           @id
    user_id        BigInt
    school_id      BigInt
    hagwon_id      BigInt?
    grade          Int?
    is_approved    Boolean?
    parent_student parent_student[]
    users          User             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    hagwon         Hagwon?          @relation(fields: [hagwon_id], references: [id])
    school         School?          @relation(fields: [school_id], references: [id])

    @@index([user_id], map: "idx_student_user_id")
}

model Parent {
    id             BigInt           @id
    user_id        BigInt
    is_approved    Boolean?
    users          User             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    parent_student parent_student[]
}

model parent_student {
    id         BigInt  @id
    student_id BigInt
    parent_id  BigInt
    parent     Parent  @relation(fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    student    Student @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Helper {
    id           BigInt    @id
    user_id      BigInt
    principal_id BigInt
    is_approved  Boolean?
    principal    Principal @relation(fields: [principal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    users        User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
