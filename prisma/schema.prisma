generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model app_user {
    id           BigInt      @id @default(autoincrement())
    name         String      @db.VarChar(255)
    role         role?
    phone_number String?     @db.VarChar(16)
    kakao_id     BigInt?     @unique
    email        String?     @unique
    password     String?     @db.VarChar(255)
    principal    principal[]
    helper       helper?
    student      student?
    parent       parent[]
}

model principal {
    id          BigInt    @id @default(autoincrement())
    hagwon_id   BigInt
    user_id     BigInt?
    is_approved Boolean?
    helper      helper[]
    hagwon      hagwon    @relation(fields: [hagwon_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    users       app_user? @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model hagwon {
    id        BigInt      @id @default(autoincrement())
    name      String?     @db.VarChar(255)
    principal principal[]
    student   student[]
}

model school {
    id      BigInt    @id @default(autoincrement())
    name    String    @db.VarChar(255)
    student student[]
}

model student {
    id             BigInt           @id @default(autoincrement())
    user_id        BigInt           @unique
    school_id      BigInt
    hagwon_id      BigInt?
    grade          Int?
    is_approved    Boolean?
    parent_student parent_student[]
    users          app_user         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    hagwon         hagwon?          @relation(fields: [hagwon_id], references: [id])
    school         school?          @relation(fields: [school_id], references: [id])

    @@index([user_id], map: "idx_student_user_id")
}

model parent {
    id             BigInt           @id @default(autoincrement())
    user_id        BigInt
    is_approved    Boolean?
    users          app_user         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    parent_student parent_student[]
}

model parent_student {
    id         BigInt  @id @default(autoincrement())
    student_id BigInt
    parent_id  BigInt
    parent     parent  @relation(fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    student    student @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model helper {
    id           BigInt    @id @default(autoincrement())
    user_id      BigInt    @unique
    principal_id BigInt
    is_approved  Boolean?
    principal    principal @relation(fields: [principal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    users        app_user  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum role {
    STUDENT
    PARENT
    PRINCIPAL
    HELPER
    MAINTAINER
}
