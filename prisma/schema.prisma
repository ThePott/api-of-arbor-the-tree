generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model users {
    id           BigInt      @id
    name         String      @db.VarChar(255)
    role         String      @db.VarChar(255)
    phone_number String      @db.VarChar(16)
    principal    principal[]
    helper       helper[]
    student      student[]
    parent       parent[]
}

model principal {
    id          BigInt   @id
    hagwon_id   BigInt
    user_id     BigInt?
    is_approved Boolean?
    helper      helper[]
    hagwon      hagwon   @relation(fields: [hagwon_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
    users       users?   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model hagwon {
    id        BigInt      @id
    name      String?     @db.VarChar(255)
    principal principal[]
    student   student[]
}

model school {
    id      BigInt    @id
    name    String    @db.VarChar(255)
    student student[]
}

model student {
    id             BigInt           @id
    user_id        BigInt
    school_id      BigInt
    hagwon_id      BigInt?
    grade          Int?
    is_approved    Boolean?
    parent_student parent_student[]
    users          users            @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
    hagwon         hagwon?          @relation(fields: [hagwonId], references: [id])
    hagwonId       BigInt?
    school         school?          @relation(fields: [schoolId], references: [id])
    schoolId       BigInt?

    @@index([user_id], map: "idx_student_user_id")
}

model parent {
    id             BigInt           @id
    user_id        BigInt
    is_approved    Boolean?
    users          users            @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
    parent_student parent_student[]
}

model parent_student {
    id         BigInt  @id
    student_id BigInt
    parent_id  BigInt
    parent     parent  @relation(fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
    student    student @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model helper {
    id           BigInt    @id
    user_id      BigInt
    principal_id BigInt
    is_approved  Boolean?
    principal    principal @relation(fields: [principal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
    users        users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
